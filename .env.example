# 환경 변수 설정 예시
# 실제 사용 시 .env 파일로 복사하여 사용

# Supabase 설정 (웹앱용)
SUPABASE_URL=https://kkaltyxehwupjxijpwtv.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# 웹사이트 로그인 정보
WEB_USERNAME=your_username
WEB_PASSWORD=your_password

# 데이터베이스 설정 (향후 사용)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bid_prediction
DB_USER=postgres
DB_PASSWORD=your_db_password

# MLflow 설정
MLFLOW_TRACKING_URI=http://localhost:5000

# API 설정
API_HOST=0.0.0.0
API_PORT=8000

# 로그 레벨
LOG_LEVEL=INFO

# 데이터 수집 설정
MAX_PAGES=10
DELAY_SECONDS=2.0
RETRY_ATTEMPTS=3